# LAMS 2.0 environment configuration. Copy to .env and fill in real values.

# --- Server ---
NODE_ENV=development
PORT=3000

# Only when a reverse proxy (e.g. nginx) sits in front of the portal: the number of proxies, so the real
# client address is read from X-Forwarded-For. Leave unset when the portal is opened directly at :3000.
# TRUST_PROXY=1

# --- Database (MySQL) ---
# The PC used for development and the server can both point at the same shared database.
# Option 1 - separate parts (simplest; symbols such as @ in the password need no changes):
# DB_HOST=172.16.30.250
# DB_PORT=3306
# DB_USER=lams2_app
# DB_PASSWORD=
# DB_NAME=lams2_db
# Option 2 - one address (in the password write @ as %40, # as %23, % as %25):
DATABASE_URL=mysql://user:password@localhost:3306/lams_db
# Connections per server process (default 40) and how many requests may wait for one (default 500).
DB_POOL_SIZE=40
# DB_QUEUE_LIMIT=500
# A SELECT running longer than this is stopped by MySQL (default 30000 ms).
# DB_QUERY_TIMEOUT_MS=30000

# --- Sign-in ---
# Only these email domains can sign in (comma-separated, exact match).
LOGIN_EMAIL_DOMAINS=wii.gov.in,edu.wii.gov.in

# --- Sessions ---
# Sign out after this many minutes without activity (default 15).
SESSION_IDLE_MINUTES=15
# Sign out this many hours after login, however active (default 8).
SESSION_MAX_HOURS=8
# Required in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Sessions are stored in the web_sessions table (migrations/20261029_web_sessions.sql).
# Set to "memory" only for local development without that table.
# SESSION_STORE=memory

# --- Email (SMTP) ---
# Public address of the portal, e.g. http://172.16.30.250:3000 . Emails link to it
# (welcome mails show it as the portal address). Use the SAME value on every machine,
# so mails sent while testing on a PC still point to the real portal.
# APP_URL=
# Sender and SMTP server are normally managed in Master Settings > Organization
# (stored in the email_settings table). The values below are only used until
# they are saved there.
# Key used to encrypt the saved SMTP password (falls back to SESSION_SECRET).
# Every machine that shares one database (e.g. a development PC and the server) MUST use
# the same value, or the password saved on one cannot be read on the other and no mail
# goes out there. Changing it means the SMTP password must be entered again.
SETTINGS_ENCRYPTION_KEY=
# Fallback default password for new employees, used only until an administrator
# sets one in Master Settings -> Organization. Leave empty in production.
# DEFAULT_EMPLOYEE_PASSWORD=
# Set to true only for an internal mail server with a self-signed certificate.
# SMTP_ALLOW_SELF_SIGNED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@wii.gov.in
EMAIL_FROM_NAME=Wildlife Institute of India Notifications

# Sign-in CAPTCHA (picture of characters, checked on the server). Set to "off" only for local development.
# LOGIN_CAPTCHA=on
