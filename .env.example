# LAMS 2.0 environment configuration. Copy to .env and fill in real values.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (MySQL) ---
DATABASE_URL=mysql://user:password@localhost:3306/lams_db
DB_POOL_SIZE=10

# --- Sessions ---
# Sign out after this many minutes without activity (default 15).
SESSION_IDLE_MINUTES=15
# Sign out this many hours after login, however active (default 8).
SESSION_MAX_HOURS=8
# Required in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Sessions are stored in the web_sessions table (migrations/20261029_web_sessions.sql).
# Set to "memory" only for local development without that table.
# SESSION_STORE=memory

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@wii.gov.in
EMAIL_FROM_NAME=Wildlife Institute of India Notifications
